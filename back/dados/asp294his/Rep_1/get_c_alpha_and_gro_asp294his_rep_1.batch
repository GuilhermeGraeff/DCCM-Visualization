#!/bin/bash
#SBATCH -n 1
#SBATCH -p fila4
#SBATCH
source /opt/apps/gromacs20250/bin/GMXRC
WORKDIR=/path/to/your/system/data/asp294his/Rep_1
cd $WORKDIR

echo -e "1 & 3 \nq" | gmx make_ndx -n /path/to/your/system/data/asp294his/Rep_1/index_novo.ndx

echo 'Protein_&_C-alpha' | gmx trjconv -s /path/to/your/system/data/asp294his/Rep_1/protein_md.tpr -f /path/to/your/system/data/asp294his/Rep_1/protein_md_rot_trans.trr -n /path/to/your/system/data/asp294his/Rep_1/index.ndx  -o /path/to/your/system/data/asp294his/Rep_1/traj_CA.xtc


echo 'Protein_&_C-alpha'| gmx trjconv -s /path/to/your/system/data/asp294his/Rep_1/protein_md.tpr -f /path/to/your/system/data/asp294his/Rep_1/protein_md.gro -n  /path/to/your/system/data/asp294his/Rep_1/index.ndx -o /path/to/your/system/data/asp294his/Rep_1/protein_CA_only.gro -dump 0
